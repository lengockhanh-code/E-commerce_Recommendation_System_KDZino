# MerRec Environment Variables Configuration (Example)

# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5432/merrec)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merrec

# Path to Full Item Catalog Parquet File (Default: data/processed/recommender/serving/item_catalog_full.parquet)
MERREC_CATALOG_PATH=data/processed/recommender/serving/item_catalog_full.parquet

# Force Parquet fallback for local development without PostgreSQL (1 = enabled, 0 = disabled)
MERREC_FORCE_PARQUET=0

# Online ranker: rules (default), lightgbm, or dcn. Enable lightgbm only after
# training/evaluating scripts/train_lightgbm_ranker.py and reviewing its metrics.
MERREC_RANKER=rules
MERREC_LIGHTGBM_PATH=training/lightgbm_ranker/model/lightgbm_ranker.txt

# Python executable override (optional)
MERREC_PYTHON=.venv/Scripts/python.exe
